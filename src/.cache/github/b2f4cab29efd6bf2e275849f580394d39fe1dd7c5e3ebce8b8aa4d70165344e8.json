t/claude-dev", "name": "claude-dev"}}}], "created_at": "2026-10-01T21:26:31Z", "updated_at": "2026-10-01T21:36:22Z", "actor": {"login": "abeatrix", "id": 68532117, "node_id": "MDQ6VXNlcjY4NTMyMTE3", "avatar_url": "https://avatars.githubusercontent.com/u/68532117?v=4", "gravatar_id": "", "url": "https://api.github.com/users/abeatrix", "html_url": "https://github.com/abeatrix", "followers_url": "https://api.github.com/users/abeatrix/followers", "following_url": "https://api.github.com/users/abeatrix/following{/other_user}", "gists_url": "https://api.github.com/users/abeatrix/gists{/gist_id}", "starred_url": "https://api.github.com/users/abeatrix/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/abeatrix/subscriptions", "organizations_url": "https://api.github.com/users/abeatrix/orgs", "repos_url": "https://api.github.com/users/abeatrix/repos", "events_url": "https://api.github.com/users/abeatrix/events{/privacy}", "received_events_url": "https://api.github.com/users/abeatrix/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "run_attempt": 1, "referenced_workflows": [], "run_started_at": "2026-10-01T21:26:31Z", "triggering_actor": {"login": "abeatrix", "id": 68532117, "node_id": "MDQ6VXNlcjY4NTMyMTE3", "avatar_url": "https://avatars.githubusercontent.com/u/68532117?v=4", "gravatar_id": "", "url": "https://api.github.com/users/abeatrix", "html_url": "https://github.com/abeatrix", "followers_url": "https://api.github.com/users/abeatrix/followers", "following_url": "https://api.github.com/users/abeatrix/following{/other_user}", "gists_url": "https://api.github.com/users/abeatrix/gists{/gist_id}", "starred_url": "https://api.github.com/users/abeatrix/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/abeatrix/subscriptions", "organizations_url": "https://api.github.com/users/abeatrix/orgs", "repos_url": "https://api.github.com/users/abeatrix/repos", "events_url": "https://api.github.com/users/abeatrix/events{/privacy}", "received_events_url": "https://api.github.com/users/abeatrix/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "jobs_url": "https://api.github.com/repos/cline/cline/actions/runs/36928694731/jobs", "logs_url": "https://api.github.com/repos/cline/cline/actions/runs/36928694731/logs", "check_suite_url": "https://api.github.com/repos/cline/cline/check-suites/100029817623", "artifacts_url": "https://api.github.com/repos/cline/cline/actions/runs/36928694731/artifacts", "cancel_url": "https://api.github.com/repos/cline/cline/actions/runs/36928694731/cancel", "rerun_url": "https://api.github.com/repos/cline/cline/actions/runs/36928694731/rerun", "previous_attempt_url": null, "workflow_url": "https://api.github.com/repos/cline/cline/actions/workflows/277510014", "head_commit": {"id": "5349bed08f36b53b158205ddefee7ebbfd61d12a", "tree_id": "efad7d18559bbb3ca5c6ee207554c0e44456d638", "message": "fix(core): stop rewriting full team state on every streamed teammate chunk (#14729)\n\n* fix(core): stop rewriting full team state on every streamed teammate chunk\n\n* fix(core): retry failed team writes and persist retry/eventless state changes\n\n- TeamPersistenceWriter requeues a failed batch and retries it instead of\n  dropping it; dispose no longer schedules retries after shutdown.\n- Scheduled retries (run_progress with a queued run) are durable and flushed\n  immediately so recovery cannot grant an extra attempt.\n- AgentTeamsRuntime notifies onStateDirty for eventless changes (mailbox\n  read receipts, cleanup) so they are written promptly.\n- Telemetry progress throttle sends the latest event at the end of the window.\n- drainStateDelta only indexes mailbox/mission log when they changed.\n- handleTeamEvent applies the team_events retention cap.\n- File history compaction is also bounded by bytes to avoid repeated rewrites.\n- Remove unused TeamRunRow interface.\n\n* fix(core): keep team write retries from duplicating history or dropping on logger errors\n\n- Report write errors after requeueing so a throwing logger cannot lose the batch\n- File store writes state before history; compaction and SQLite pruning are best-effort post-commit\n- Clear queued telemetry progress when a durable event supersedes it\n\n* fix(core): re-import legacy team state_json on every open\n\nv2 builds only write an empty state_json, so a non-empty value means an\nolder build wrote it (e.g. after an image rollback). Previously it was\nonly imported during the one-time v2 migration, so writes made by a\nrolled-back build were dropped after re-upgrading. Run the import on\nevery open.\n\n* fix(core): avoid polynomial regex when trimming team names\n\n`/^-+|-+$/` backtracks quadratically on long runs of `-` (CodeQL\njs/polynomial-redos). Trim leading/trailing dashes by index instead.\n\n* refactor(core): share a single sanitizeTeamName helper\n\nFour copies existed; one (team-persistence-store) still used the\npolynomial `/^-+|-+$/` trim. Move it to a dependency-free module so\nstorage can import it without pulling in team-tools.", "timestamp": "2026-10-01T21:26:26Z", "author": {"name": "Bee", "email": "68532117+abeatrix@users.noreply.github.com"}, "committer": {"name": "GitHub", "email": "noreply@github.com"}}, "repository": {"id": 824874689, "node_id": "R_kgDOMSqWwQ", "name": "cline", "full_name": "cline/cline", "private": false, "owner": {"login": "cline", "id": 184127137, "node_id": "O_kgDOCvmOoQ", "avatar_url": "https://avatars.githubusercontent.com/u/184127137?v=4", "gravatar_id": "", "url": "https://api.github.com/users/cline", "html_url": "https://github.com/cline", "followers_url": "https://api.github.com/users/cline/followers", "following_url": "https://api.github.com/users/cline/following{/other_user}", "gists_url": "https://api.github.com/users/cline/gists{/gist_id}", "starred_url": "https://api.github.com/users/cline/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.co