om/repos/rosedblabs/rosedb/releases/117744422/assets{?name,label}", "html_url": "https://github.com/rosedblabs/rosedb/releases/tag/v2.3.0", "id": 117744422, "author": {"login": "roseduan", "id": 22375523, "node_id": "MDQ6VXNlcjIyMzc1NTIz", "avatar_url": "https://avatars.githubusercontent.com/u/22375523?v=4", "gravatar_id": "", "url": "https://api.github.com/users/roseduan", "html_url": "https://github.com/roseduan", "followers_url": "https://api.github.com/users/roseduan/followers", "following_url": "https://api.github.com/users/roseduan/following{/other_user}", "gists_url": "https://api.github.com/users/roseduan/gists{/gist_id}", "starred_url": "https://api.github.com/users/roseduan/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/roseduan/subscriptions", "organizations_url": "https://api.github.com/users/roseduan/orgs", "repos_url": "https://api.github.com/users/roseduan/repos", "events_url": "https://api.github.com/users/roseduan/events{/privacy}", "received_events_url": "https://api.github.com/users/roseduan/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "node_id": "RE_kwDOEwMicM4HBKMm", "tag_name": "v2.3.0", "target_commitish": "main", "name": "Release v2.3.0", "draft": false, "immutable": false, "prerelease": false, "created_at": "2023-08-18T10:05:44Z", "updated_at": "2023-08-18T13:23:27Z", "published_at": "2023-08-18T10:13:17Z", "assets": [], "tarball_url": "https://api.github.com/repos/rosedblabs/rosedb/tarball/v2.3.0", "zipball_url": "https://api.github.com/repos/rosedblabs/rosedb/zipball/v2.3.0", "body": "## \ud83d\ude80 New Features\r\n* use BTree as the default memory data structure.\r\n  * the old Radix will be removed, and the iterator too.\r\n## \ud83c\udfa0 Community\r\n* Thanks to @Jeremy-Run \r\n    * remove merge file after tests (https://github.com/rosedblabs/rosedb/pull/250)\r\n    * replace original file and rebuilt index after merge (https://github.com/rosedblabs/rosedb/pull/255)\r\n* Thanks to @SYaoJun \r\n    * fix: single quote error in README (https://github.com/rosedblabs/rosedb/pull/256)\r\n* Thanks to @weijiew \r\n    * add btree Ascend\u3001Descend method and unitest. (https://github.com/rosedblabs/rosedb/pull/257)\r\n", "discussion_url": "https://github.com/orgs/rosedblabs/discussions/260", "mentions_count": 3}, {"url": "https://api.github.com/repos/rosedblabs/rosedb/releases/115262093", "assets_url": "https://api.github.com/repos/rosedblabs/rosedb/releases/115262093/assets", "upload_url": "https://uploads.github.com/repos/rosedblabs/rosedb/releases/115262093/assets{?name,label}", "html_url": "https://github.com/rosedblabs/rosedb/releases/tag/v2.2.2", "id": 115262093, "author": {"login": "roseduan", "id": 22375523, "node_id": "MDQ6VXNlcjIyMzc1NTIz", "avatar_url": "https://avatars.githubusercontent.com/u/22375523?v=4", "gravatar_id": "", "url": "https://api.github.com/users/roseduan", "html_url": "https://github.com/roseduan", "followers_url": "https://api.github.com/users/roseduan/followers", "following_url": "https://api.github.com/users/roseduan/following{/other_user}", "gists_url": "https://api.github.com/users/roseduan/gists{/gist_id}", "starred_url": "https://api.github.com/users/roseduan/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/roseduan/subscriptions", "organizations_url": "https://api.github.com/users/roseduan/orgs", "repos_url": "https://api.github.com/users/roseduan/repos", "events_url": "https://api.github.com/users/roseduan/events{/privacy}", "received_events_url": "https://api.github.com/users/roseduan/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "node_id": "RE_kwDOEwMicM4G3sKN", "tag_name": "v2.2.2", "target_commitish": "main", "name": "Release v2.2.2", "draft": false, "immutable": false, "prerelease": false, "created_at": "2023-08-05T08:01:49Z", "updated_at": "2023-08-05T08:02:36Z", "published_at": "2023-08-05T08:02:35Z", "assets": [], "tarball_url": "https://api.github.com/repos/rosedblabs/rosedb/tarball/v2.2.2", "zipball_url": "https://api.github.com/repos/rosedblabs/rosedb/zipball/v2.2.2", "body": "## \ud83d\ude80 New Features\r\n* Watch Key [feature support watch event by key #227](https://github.com/rosedblabs/rosedb/issues/227) @Jeremy-Run \r\n\r\n## \ud83c\udf84 Enhancements\r\n\r\n* Batch Optimiztion [use sync.Pool to optimize db.Put operation #235](https://github.com/rosedblabs/rosedb/issues/235)\r\n* Optimize memory usage [enhancement: high memory usage of rosedb #236](https://github.com/rosedblabs/rosedb/issues/236)\r\n\r\n## \ud83c\udfa0 Community\r\n* Thanks to @kebukeYi \r\n    * Change Variable name in openMergeDB (https://github.com/rosedblabs/rosedb/pull/228)\r\n    * Avoid parsing wal files repeatedly. (https://github.com/rosedblabs/rosedb/pull/229)\r\n* Thanks to @Jeremy-Run \r\n    * Deleted data cannot exist in the index (https://github.com/rosedblabs/rosedb/pull/232)\r\n    * fix: solve data race (https://github.com/rosedblabs/rosedb/pull/234)\r\n    * fix: destFile may be not exist (https://github.com/rosedblabs/rosedb/pull/243)\r\n* Thanks to @rfyiamcool \r\n    * fix: format code comment for rand_kv (https://github.com/rosedblabs/rosedb/pull/240)", "discussion_url": "https://github.com/orgs/rosedblabs/discussions/248", "reactions": {"url": "https://api.github.com/repos/rosedblabs/rosedb/releases/115262093/reactions", "total_count": 5, "+1": 2, "-1": 0, "laugh": 2, "hooray": 1, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "mentions_count": 3}, {"url": "https://api.github.com/repos/rosedblabs/rosedb/releases/110866906", "assets_url": "https://api.github.com/repos/rosedblabs/rosedb/releases/110866906/assets", "upload_url": "https://uploads.github.com/repos/rosedblabs/rosedb/releases/110866906/assets{?name,label}", "html_url": "https://github.com/rosedblabs/rosedb/releases/tag/v2.2.1", "id": 110866906, "author": {"login": "roseduan", "id": 22375523, "node_id": "MDQ6VXNlcjIyMzc1NT