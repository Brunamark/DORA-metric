{"status": 200, "body": {"total_count": 25, "workflow_runs": [{"id": 30945958520, "name": "build", "node_id": "WFR_kwLODax7Ts8AAAAHNIXaeA", "head_branch": "stable", "head_sha": "7e99e6895063713b61b450aaadef74cf498fc979", "path": ".github/workflows/build.yml", "display_title": "android, desktop: fix draft appearing in another chat when switching \u2026", "run_number": 31003, "event": "push", "status": "completed", "conclusion": "success", "workflow_id": 8717733, "check_suite_id": 83925458507, "check_suite_node_id": "CS_kwDODax7Ts8AAAATiljeSw", "url": "https://api.github.com/repos/simplex-chat/simplex-chat/actions/runs/30945958520", "html_url": "https://github.com/simplex-chat/simplex-chat/actions/runs/30945958520", "pull_requests": [{"url": "https://api.github.com/repos/fenglinyes/simplex-chat/pulls/10", "id": 4325596591, "number": 10, "head": {"ref": "stable", "sha": "479548ee53ffb73db73841e77acbeee5a78dbbd5", "repo": {"id": 229407566, "url": "https://api.github.com/repos/simplex-chat/simplex-chat", "name": "simplex-chat"}}, "base": {"ref": "stable", "sha": "0ec028a6684ecc976f3aaeb35b0f295734b0417a", "repo": {"id": 1324241193, "url": "https://api.github.com/repos/fenglinyes/simplex-chat", "name": "simplex-chat"}}}, {"url": "https://api.github.com/repos/swaitw/simplex-chat/pulls/12", "id": 4324817353, "number": 12, "head": {"ref": "stable", "sha": "479548ee53ffb73db73841e77acbeee5a78dbbd5", "repo": {"id": 229407566, "url": "https://api.github.com/repos/simplex-chat/simplex-chat", "name": "simplex-chat"}}, "base": {"ref": "stable", "sha": "5e45fe1f0e26b0cd2b0ed5be91722067df13ddbd", "repo": {"id": 1286566580, "url": "https://api.github.com/repos/swaitw/simplex-chat", "name": "simplex-chat"}}}], "created_at": "2026-08-04T20:01:38Z", "updated_at": "2026-08-04T23:26:07Z", "actor": {"login": "epoberezkin", "id": 2769109, "node_id": "MDQ6VXNlcjI3NjkxMDk=", "avatar_url": "https://avatars.githubusercontent.com/u/2769109?v=4", "gravatar_id": "", "url": "https://api.github.com/users/epoberezkin", "html_url": "https://github.com/epoberezkin", "followers_url": "https://api.github.com/users/epoberezkin/followers", "following_url": "https://api.github.com/users/epoberezkin/following{/other_user}", "gists_url": "https://api.github.com/users/epoberezkin/gists{/gist_id}", "starred_url": "https://api.github.com/users/epoberezkin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/epoberezkin/subscriptions", "organizations_url": "https://api.github.com/users/epoberezkin/orgs", "repos_url": "https://api.github.com/users/epoberezkin/repos", "events_url": "https://api.github.com/users/epoberezkin/events{/privacy}", "received_events_url": "https://api.github.com/users/epoberezkin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "run_attempt": 2, "referenced_workflows": [], "run_started_at": "2026-08-04T22:24:04Z", "triggering_actor": {"login": "epoberezkin", "id": 2769109, "node_id": "MDQ6VXNlcjI3NjkxMDk=", "avatar_url": "https://avatars.githubusercontent.com/u/2769109?v=4", "gravatar_id": "", "url": "https://api.github.com/users/epoberezkin", "html_url": "https://github.com/epoberezkin", "followers_url": "https://api.github.com/users/epoberezkin/followers", "following_url": "https://api.github.com/users/epoberezkin/following{/other_user}", "gists_url": "https://api.github.com/users/epoberezkin/gists{/gist_id}", "starred_url": "https://api.github.com/users/epoberezkin/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/epoberezkin/subscriptions", "organizations_url": "https://api.github.com/users/epoberezkin/orgs", "repos_url": "https://api.github.com/users/epoberezkin/repos", "events_url": "https://api.github.com/users/epoberezkin/events{/privacy}", "received_events_url": "https://api.github.com/users/epoberezkin/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "jobs_url": "https://api.github.com/repos/simplex-chat/simplex-chat/actions/runs/30945958520/jobs", "logs_url": "https://api.github.com/repos/simplex-chat/simplex-chat/actions/runs/30945958520/logs", "check_suite_url": "https://api.github.com/repos/simplex-chat/simplex-chat/check-suites/83925458507", "artifacts_url": "https://api.github.com/repos/simplex-chat/simplex-chat/actions/runs/30945958520/artifacts", "cancel_url": "https://api.github.com/repos/simplex-chat/simplex-chat/actions/runs/30945958520/cancel", "rerun_url": "https://api.github.com/repos/simplex-chat/simplex-chat/actions/runs/30945958520/rerun", "previous_attempt_url": "https://api.github.com/repos/simplex-chat/simplex-chat/actions/runs/30945958520/attempts/1", "workflow_url": "https://api.github.com/repos/simplex-chat/simplex-chat/actions/workflows/8717733", "head_commit": {"id": "7e99e6895063713b61b450aaadef74cf498fc979", "tree_id": "b264cd256966b98a324e85e6b3ea6916f4d6b200", "message": "android, desktop: fix draft appearing in another chat when switching chats while sending (#7308)\n\n* ios, android, desktop: fix message being sent leaking into another chat\n\nCompose state is shared between the chats opened in the same view, and\nthe send is launched in a scope that outlives the chat, so a send that\nwas still in flight when the chat was switched put its message (with the\nreply context) into the compose state and then the draft of another chat,\nand a late success cleared whatever was typed in the meantime.\n\nThe message being sent is no longer kept in the compose state when\nleaving the chat, and the compose state is only cleared or restored after\nsending if it still holds the message that was sent - the same check is\nused by the other senders that show progress in the compose. A message\nthat failed to send is restored in the chat it was composed in, or kept\nas its draft when another chat is open (iOS has no failed message\nrestore, there the message is dropped as before).\n\n* android, desktop: keep only the chat switch fix\n\nRevert the iOS changes and the same check in the three senders that\nconnect a prepared chat, leaving the fix for the compose state shared\nbetween the chats opened in one view.\n\n* plan: document what the narrowed change leaves to the connect senders\n\n* android, desktop: use the same check where the sending flag is shared\n\nThe senders that connect a prepared chat set the same inProgress flag,\nso a connect completing after the chat was switched cleared it for a\nsend started in the chat opened next, and that sent message was then\nleft in the compose.\n\n* android, desktop: keep the live message clauses inside the open chat check\n\nlive and cs.liveMessage != null were alternatives to chatIsOpen, which\nholds only while a live message is always sent to the chat that is open.\n#7323 removes that: the live message committed by a chat switch is sent\nto the chat it was composed in, while this view already shows another\none, so an unguarded clause here clears that chat's compose state - the\nleak this fix exists to prevent.\n\nliveSend stays an alternative to inProgress inside the guard, so a live\nsend behaves exactly as before while its chat is open, and it is excluded\nfrom the restore/draft branch, which would otherwise write a draft on\nevery failing keystroke send once that chat is no longer open. On this\nbranch the only behaviour change is a live send completing after its chat\nwas left, which now leaves the opened chat alone.\n\nAlso load the draft of the chat opened next when the compose state is\ncleared on switching away from a send in flight: clearState() returns\nbefore the branch that loads a draft, so that draft was never shown, and\nbeing in the slot but in no compose state it was then dropped by\nclearPrevDraft on the next chat switch.\n\n* plan: explain why live sends are guarded by the open chat check\n\nRecords that the exemption in \"Deliberately unchanged\" is from a guard\nbased on inProgress, not from chatIsOpen, and why the earlier form broke\nonce #7323 sends a live message to a chat other than the one open.", "timestamp": "2026-08-04T20:01:35Z", "author": {"name": "Narasimha-sc", "email": "166327228+Narasimha-sc@users.noreply.github.com"}, "committer": {"name": "GitHub", "email": "noreply@github.com"}}, "repository": {"id": 229407566, "node_id": "MDEwOlJlcG9zaXRvcnkyMjk0MDc1NjY=", "name": "simplex-chat", "full_name": "simplex-chat/simplex-chat", "private": false, "owner": {"login": "simplex-chat", "id": 59927747, "node_id": "MDEyOk9yZ2FuaXphdGlvbjU5OTI3NzQ3", "avatar_url": "https://avatars.githubusercontent.com/u/59927747?v=4", "gravatar_id": "", "url": "https://api.github.com/users/simplex-chat", "html_url": "https://github.com/simplex-chat", "followers_url": "https://api.github.com/users/simplex-chat/followers", "following_url": "https://api.github.com/users/simplex-chat/following{/other_user}", "gists_url": "https://api.github.com/users/simplex-chat/gists{/gist_id}", "starred_url": "https://api.github.com/users/simplex-chat/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/simplex-chat/subscriptions", "organizations_url": "https://api.github.com/users/simplex-chat/orgs", "repos_url": "https://api.github.com/users/simplex-chat/repos", "events_url": "https://api.github.com/users/simplex-chat/events{/privacy}", "received_events_url": "https://api.github.com/users/simplex-chat/received_events", "type": "Organization", "user_view_type": "public", "site_admin": false}, "html_url": "https://github.com/simplex-chat/simplex-chat", "description": "SimpleX - the first messaging network operating without user identifiers of any kind - 100% private by design! iOS, Android and desktop apps \ud83d\udcf1!", "fork": false, "url": "https://api.github.com/repos/simplex-chat/simplex-chat", "forks_url": "https://api.github.com/repos/simplex-chat/simplex-chat/forks", "keys_url": "https://api.github.com/repos/simplex-chat/simplex-chat/keys{/key_id}", "collaborators_url": "https://api.github.com/repos/simplex-chat/simplex-cha