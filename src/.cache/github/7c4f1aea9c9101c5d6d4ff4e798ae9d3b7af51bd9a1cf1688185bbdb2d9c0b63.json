-11-06T09:56:37Z", "assets": [], "tarball_url": "https://api.github.com/repos/deviantony/docker-elk/tarball/8.2511.1", "zipball_url": "https://api.github.com/repos/deviantony/docker-elk/zipball/8.2511.1", "body": "Default Elastic version: `8.19.6`\r\n\r\n> **Note**\r\n> _See [version selection](https://github.com/deviantony/docker-elk/tree/release-8.x#version-selection) to run a different version._\r\n\r\n### Notable changes\r\n\r\n- A new Compose service `kibana-genkeys` allows generating encryption keys for Kibana."}, {"url": "https://api.github.com/repos/deviantony/docker-elk/releases/217414534", "assets_url": "https://api.github.com/repos/deviantony/docker-elk/releases/217414534/assets", "upload_url": "https://uploads.github.com/repos/deviantony/docker-elk/releases/217414534/assets{?name,label}", "html_url": "https://github.com/deviantony/docker-elk/releases/tag/9.2505.1", "id": 217414534, "author": {"login": "antoineco", "id": 3299086, "node_id": "MDQ6VXNlcjMyOTkwODY=", "avatar_url": "https://avatars.githubusercontent.com/u/3299086?v=4", "gravatar_id": "", "url": "https://api.github.com/users/antoineco", "html_url": "https://github.com/antoineco", "followers_url": "https://api.github.com/users/antoineco/followers", "following_url": "https://api.github.com/users/antoineco/following{/other_user}", "gists_url": "https://api.github.com/users/antoineco/gists{/gist_id}", "starred_url": "https://api.github.com/users/antoineco/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/antoineco/subscriptions", "organizations_url": "https://api.github.com/users/antoineco/orgs", "repos_url": "https://api.github.com/users/antoineco/repos", "events_url": "https://api.github.com/users/antoineco/events{/privacy}", "received_events_url": "https://api.github.com/users/antoineco/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "node_id": "RE_kwDOAZlbsM4M9XuG", "tag_name": "9.2505.1", "target_commitish": "main", "name": "", "draft": false, "immutable": false, "prerelease": false, "created_at": "2025-05-08T18:30:41Z", "updated_at": "2025-05-11T17:46:36Z", "published_at": "2025-05-08T18:53:37Z", "assets": [], "tarball_url": "https://api.github.com/repos/deviantony/docker-elk/tarball/9.2505.1", "zipball_url": "https://api.github.com/repos/deviantony/docker-elk/zipball/9.2505.1", "body": "Default Elastic version: `9.0.1`\r\n\r\n> **Note**\r\n> _See [version selection](https://github.com/deviantony/docker-elk#version-selection) to run a different version._\r\n\r\n### Notable changes\r\n\r\n- The `main` branch now follows the 9.x release series of Elastic components.\r\n\r\n    Moving forward, all changes on the `main` branch should be considered **incompatible** with the 8.x release series, which is now being tracked on the `release-8.x` branch.\r\n\r\nList of changes impacting docker-elk:\r\n\r\n#### Kibana\r\n\r\n- Several features now require an encryption key for saved objects. Such key must be set via the configuration option `xpack.encryptedSavedObjects.encryptionKey`.\r\n\r\n    Ref: https://www.elastic.co/docs/deploy-manage/security/secure-saved-objects\r\n\r\n#### Enterprise Search extension\r\n\r\n- Discontinued in 9.x versions.\r\n\r\n    Refs:\r\n    - https://www.elastic.co/guide/en/enterprise-search/8.18/upgrading-to-9-x.html\r\n    - https://www.elastic.co/blog/app-search-to-elasticsearch", "reactions": {"url": "https://api.github.com/repos/deviantony/docker-elk/releases/217414534/reactions", "total_count": 2, "+1": 0, "-1": 0, "laugh": 0, "hooray": 2, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}}, {"url": "https://api.github.com/repos/deviantony/docker-elk/releases/210654088", "assets_url": "https://api.github.com/repos/deviantony/docker-elk/releases/210654088/assets", "upload_url": "https://uploads.github.com/repos/deviantony/docker-elk/releases/210654088/assets{?name,label}", "html_url": "https://github.com/deviantony/docker-elk/releases/tag/8.2504.1", "id": 210654088, 