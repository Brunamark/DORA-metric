8235?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Leward", "html_url": "https://github.com/Leward", "followers_url": "https://api.github.com/users/Leward/followers", "following_url": "https://api.github.com/users/Leward/following{/other_user}", "gists_url": "https://api.github.com/users/Leward/gists{/gist_id}", "starred_url": "https://api.github.com/users/Leward/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Leward/subscriptions", "organizations_url": "https://api.github.com/users/Leward/orgs", "repos_url": "https://api.github.com/users/Leward/repos", "events_url": "https://api.github.com/users/Leward/events{/privacy}", "received_events_url": "https://api.github.com/users/Leward/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "jobs_url": "https://api.github.com/repos/redpanda-data/connect/actions/runs/36437042696/jobs", "logs_url": "https://api.github.com/repos/redpanda-data/connect/actions/runs/36437042696/logs", "check_suite_url": "https://api.github.com/repos/redpanda-data/connect/check-suites/98660216733", "artifacts_url": "https://api.github.com/repos/redpanda-data/connect/actions/runs/36437042696/artifacts", "cancel_url": "https://api.github.com/repos/redpanda-data/connect/actions/runs/36437042696/cancel", "rerun_url": "https://api.github.com/repos/redpanda-data/connect/actions/runs/36437042696/rerun", "previous_attempt_url": null, "workflow_url": "https://api.github.com/repos/redpanda-data/connect/actions/workflows/6881020", "head_commit": {"id": "a89faa2e6d07aa5694cbaf70d23d1eb6e1656605", "tree_id": "04bc6cc7f9fb44353024d89462f293fdac39bedc", "message": "oracledb_cdc: stop the logminer wait when the context is cancelled (#4881)\n\n* oracledb_cdc: stop the logminer wait when the context is cancelled\n\nThe mining loop used time.Sleep between cycles. time.Sleep does not\nreturn when the context is cancelled. Thus a shutdown while the miner\nwas caught up waited for the full logminer.backoff_interval (5s by\ndefault). A large backoff_interval made the shutdown exceed the\nStopWithin timeouts.\n\nReplace the two sleeps with a wait that returns ctx.Err() when the\ncontext is cancelled. Add a unit test that cancels ReadChanges during\na 1 minute backoff and expects it to return immediately.\n\n* oracledb_cdc: use an inline select for the logminer wait\n\nRemove the sleepCtx helper. The wait has one call site, and other\nconnectors in this repo use an inline select on ctx.Done() and\ntime.After for this.\n\n* oracledb_cdc: group the logminer wait with the caught-up log\n\nSet the wait interval immediately before the select that uses it.\nLog the caught-up message where the backoff is selected, and print\nthe wait value. Replace the if/else chain with one caughtUp check.\nThe behavior does not change: the message is logged one time each\ntime the miner catches up.\n\n* oracledb_cdc: use one timer for the logminer wait\n\ntime.After allocates a new timer on each mining cycle. Reuse one timer and reset it before each wait.\n\n* typo/grammar\n\nCo-authored-by: Joseph Woodward <joseph.woodward@redpanda.com>\n\n---------\n\nCo-authored-by: Joseph Woodward <joseph.woodward@redpanda.com>", "timestamp": "2026-09-28T14:34:45Z", "author": {"name": "Paul-Julien Vauthier", "email": "pj82491@gmail.com"}, "committer": {"name": "GitHub", "email": "noreply@github.com"}}, "repository": {"id": 54435102, "node_id": "MDEwOlJlcG9zaXRvcnk1NDQzNTEwMg==", "name": "connect", "full_name": "redpanda-data/connect", "private": false, "owner": {"login": "redpanda-data", "id": 49406389, "node_id": "MDEyOk9yZ2FuaXphdGlvbjQ5NDA2Mzg5", "avatar_url": "https://avatars.githubusercontent.com/u/49406389?v=4", "gravatar_id": "", "url": "https://api.github.com/users/redpanda-data", "html_url": "https://github.com/redpanda-data", "followers_url": "https://api.github.com/users/redpanda-data/followers", "following_url": "https://api.github.com/users/redpanda-data/following{/other_user}", "