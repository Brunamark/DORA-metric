api.github.com/users/vyavdoshenko/following{/other_user}", "gists_url": "https://api.github.com/users/vyavdoshenko/gists{/gist_id}", "starred_url": "https://api.github.com/users/vyavdoshenko/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/vyavdoshenko/subscriptions", "organizations_url": "https://api.github.com/users/vyavdoshenko/orgs", "repos_url": "https://api.github.com/users/vyavdoshenko/repos", "events_url": "https://api.github.com/users/vyavdoshenko/events{/privacy}", "received_events_url": "https://api.github.com/users/vyavdoshenko/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "run_attempt": 1, "referenced_workflows": [], "run_started_at": "2026-09-21T11:52:55Z", "triggering_actor": {"login": "vyavdoshenko", "id": 41993419, "node_id": "MDQ6VXNlcjQxOTkzNDE5", "avatar_url": "https://avatars.githubusercontent.com/u/41993419?v=4", "gravatar_id": "", "url": "https://api.github.com/users/vyavdoshenko", "html_url": "https://github.com/vyavdoshenko", "followers_url": "https://api.github.com/users/vyavdoshenko/followers", "following_url": "https://api.github.com/users/vyavdoshenko/following{/other_user}", "gists_url": "https://api.github.com/users/vyavdoshenko/gists{/gist_id}", "starred_url": "https://api.github.com/users/vyavdoshenko/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/vyavdoshenko/subscriptions", "organizations_url": "https://api.github.com/users/vyavdoshenko/orgs", "repos_url": "https://api.github.com/users/vyavdoshenko/repos", "events_url": "https://api.github.com/users/vyavdoshenko/events{/privacy}", "received_events_url": "https://api.github.com/users/vyavdoshenko/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "jobs_url": "https://api.github.com/repos/dragonflydb/dragonfly/actions/runs/35596407887/jobs", "logs_url": "https://api.github.com/repos/dragonflydb/dragonfly/actions/runs/35596407887/logs", "check_suite_url": "https://api.github.com/repos/dragonflydb/dragonfly/check-suites/96371503468", "artifacts_url": "https://api.github.com/repos/dragonflydb/dragonfly/actions/runs/35596407887/artifacts", "cancel_url": "https://api.github.com/repos/dragonflydb/dragonfly/actions/runs/35596407887/cancel", "rerun_url": "https://api.github.com/repos/dragonflydb/dragonfly/actions/runs/35596407887/rerun", "previous_attempt_url": null, "workflow_url": "https://api.github.com/repos/dragonflydb/dragonfly/actions/workflows/16661796", "head_commit": {"id": "0fcd825ace14c9a562d24e367f99f87135981ccf", "tree_id": "8ba9f3aa2d1a87598db1c9e58d33a230a26c0386", "message": "fix(core): match globs iteratively so a pattern cannot overflow the fiber stack (#8350)\n\nfix(core): match globs iteratively so KEYS/SCAN cannot overflow the stack\n\nThe server builds glob_matcher without reflex or pcre2, so KEYS, the SCAN\nfamily, ACL key patterns, PSUBSCRIBE and CONFIG GET all match through the\nrecursive stringmatchlen. It recurses once per '*' and only gives up at\nnesting > 1000, a limit sized for a large main-thread stack. Dragonfly runs the\nmatch on a 40KB connection fiber stack, so a pattern with a few hundred stars\n(for example \"*?\" repeated) overflows it and aborts the server. One SET plus\none KEYS is enough.\n\nReplace it with GlobMatcher::MatchGlob(string_view, string_view, bool): an\niterative matcher that remembers only the last '*', so it needs O(1) state and\nno depth guard. Character-class, escape and case-folding semantics are kept\nbyte for byte, including that \"*\" does not match the empty string. Leading\nliteral bytes are compared in place, and after a '*' followed by a plain\nliteral the next candidate is located with string_view::find.\n\nChecked against the recursive version with a differential fuzz (exhaustive\nover short patterns plus random inputs, signed and unsigned char, ASAN/UBSAN):\nno mismatches. On the dfly_core_test benchmarks (release, g++ -O3, aarch64) it\nis faster than the recursive version, e.g. BM_MatchGlob/1000 1168 -> 156 ns\nand BM_MatchData 448 -> 78 us.\n\nBehavior changes, all intended:\n- patterns with more than 1000 '*' groups get the correct answer instead of\n  the guard's no-match\n- no read one byte past a trailing '*'\n- lengths stay size_t; the old int lengths overflowed for a 2GiB argument", "timestamp": "2026-09-21T11:52:50Z", "author": {"name": "Volodymyr Yavdoshenko", "email": "volodymyr@dragonflydb.io"}, "committer": {"name": "GitHub", "email": "noreply@github.com"}}, "repository": {"id": 437245741, "node_id": "R_kgDOGg_XLQ", "name": "dragonfly", "full_name": "dragonflydb/dragonfly", "private": false, "owner": {"login": "dragonflydb", "id": 104819355, "node_id": "O_kgDOBj9qmw", "avatar_url": "https://avatars.githubusercontent.com/u/104819355?v=4", "gravatar_id": "", "url": "https://api.github.com/users/dragonflydb", "html_url": "https://github.com/dragonflydb", "followers_url": "https://api.github.com/users/dragonflydb/followers", "following_url": "https://api.github.com/users/dragonflydb/following{/other_user}", "gists_url": "https://api.github.com/users/dragonflydb/gists{/gist_id}", "starred_url": "https://api.github.com/users/dragonflydb/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/dragonflydb/subscriptions", "organizations_url": "https://api.github.com/users/dragonflydb/orgs", "repos_url": "https://api.github.com/users/dragonflydb/repos", "events_url": "https://api.github.com/users/dragonflydb/events{/privacy}", "received_events_url": "https://api.github.com/users/dragonflydb/received_events", "type": "Organization", "user_view_type": "public", "site_admin": false}, "html_url": "https://github.com/dragonflydb/dragonfly", "description": "A modern replacement for Redis and Memcached", "fork": false, "url": "https://api.github.com/repos/dragonflydb/dragonfly", "forks_url": "https://api.github.com/repos/dragonflydb/dragonfly/forks", "keys_url": "https://api.github.com/repos/dragonflydb