tions_url": "https://api.github.com/users/apparentlymart/orgs", "repos_url": "https://api.github.com/users/apparentlymart/repos", "events_url": "https://api.github.com/users/apparentlymart/events{/privacy}", "received_events_url": "https://api.github.com/users/apparentlymart/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "jobs_url": "https://api.github.com/repos/opentofu/opentofu/actions/runs/35360757672/jobs", "logs_url": "https://api.github.com/repos/opentofu/opentofu/actions/runs/35360757672/logs", "check_suite_url": "https://api.github.com/repos/opentofu/opentofu/check-suites/95767060940", "artifacts_url": "https://api.github.com/repos/opentofu/opentofu/actions/runs/35360757672/artifacts", "cancel_url": "https://api.github.com/repos/opentofu/opentofu/actions/runs/35360757672/cancel", "rerun_url": "https://api.github.com/repos/opentofu/opentofu/actions/runs/35360757672/rerun", "previous_attempt_url": null, "workflow_url": "https://api.github.com/repos/opentofu/opentofu/actions/workflows/66452280", "head_commit": {"id": "6a98b9a69ec84de8d54858e70ee51ea91e09f36c", "tree_id": "54d01d3f52af260529a7088e9e273f52a415b784", "message": "configgraph: PreventDestroy returns exprs.FromValue[bool]\n\nWe originally wrote this function before we had exprs.FromValue, and so\nwe ended up just documenting the small subset of possible cty.Values it\ncould potentially return.\n\nBut with exprs.FromValue we can now use a return type that directly\nrestricts the result to only one of the valid values, thereby avoiding any\nquestion of whether the caller is expected to do additional validation of\nthe result.\n\nThis also moves the restriction against \"prevent_destroy = null\" from the\npost-plan checking code into the configgraph.PreventDestroy method, since\nthat centralizes all of the validation in one place and avoids the need\nfor this function's result to be able to represent the \"unspecified\" case.\nThe existing question of whether we want to just silently accept that as\nequivalent to \"prevent_destroy = false\" still remains documented in a\ncomment since I'm intending to focus only on refactoring here and not make\nsignificant behavior changes.\n\nSigned-off-by: Martin Atkins <mart@degeneration.co.uk>", "timestamp": "2026-09-18T15:10:10Z", "author": {"name": "Martin Atkins", "email": "mart@degeneration.co.uk"}, "committer": {"name": "Martin Atkins", "email": "mart@degeneration.co.uk"}}, "repository": {"id": 679421146, "node_id": "R_kgDOKH8k2g", "name": "opentofu", "full_name": "opentofu/opentofu", "private": false, "owner": {"login": "opentofu", "id": 142061836, "node_id": "O_kgDOCHexDA", "avatar_url": "https://avatars.githubusercontent.com/u/142061836?v=4", "gravatar_id": "", "url": "https://api.github.com/users/opentofu", "html_url": "https://github.com/opentofu", "followers_url": "https://api.github.com/users/opentofu/followers", "following_url": "https://api.github.com/users/opentofu/following{/other_user}", "gists_url": "https://api.github.com/users/opentofu/gists{/gist_id}", "starred_url": "https://api.github.com/users/opentofu/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/opentofu/subscriptions", "organizations_url": "https://api.github.com/users/opentofu/orgs", "repos_url": "https://api.github.com/users/opentofu/repos", "events_url": "https://api.github.com/users/opentofu/events{/privacy}", "received_events_url": "https://api.github.com/users/opentofu/received_events", "type": "Organization", "user_view_type": "public", "site_admin": false}, "html_url": "https://github.com/opentofu/opentofu", "description": "OpenTofu lets you declaratively manage your cloud infrastructure.", "fork": false, "url": "https://api.github.com/repos/opentofu/opentofu", "forks_url": "https://api.github.com/repos/opentofu/opentofu/forks", "keys_url": "https://api.github.com/repos/opentofu/opentofu/keys{/key_id}", "collaborators_url": "https://api.github.com/repos/opentofu/opentofu/coll