node_id": "MDQ6VXNlcjExODM4MTQ1", "avatar_url": "https://avatars.githubusercontent.com/u/11838145?v=4", "gravatar_id": "", "url": "https://api.github.com/users/marcobambini", "html_url": "https://github.com/marcobambini", "followers_url": "https://api.github.com/users/marcobambini/followers", "following_url": "https://api.github.com/users/marcobambini/following{/other_user}", "gists_url": "https://api.github.com/users/marcobambini/gists{/gist_id}", "starred_url": "https://api.github.com/users/marcobambini/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/marcobambini/subscriptions", "organizations_url": "https://api.github.com/users/marcobambini/orgs", "repos_url": "https://api.github.com/users/marcobambini/repos", "events_url": "https://api.github.com/users/marcobambini/events{/privacy}", "received_events_url": "https://api.github.com/users/marcobambini/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "jobs_url": "https://api.github.com/repos/marcobambini/gravity/actions/runs/35429636879/jobs", "logs_url": "https://api.github.com/repos/marcobambini/gravity/actions/runs/35429636879/logs", "check_suite_url": "https://api.github.com/repos/marcobambini/gravity/check-suites/95949385955", "artifacts_url": "https://api.github.com/repos/marcobambini/gravity/actions/runs/35429636879/artifacts", "cancel_url": "https://api.github.com/repos/marcobambini/gravity/actions/runs/35429636879/cancel", "rerun_url": "https://api.github.com/repos/marcobambini/gravity/actions/runs/35429636879/rerun", "previous_attempt_url": null, "workflow_url": "https://api.github.com/repos/marcobambini/gravity/actions/workflows/327853314", "head_commit": {"id": "088a1a9fd580475f8b015e9bd5543f1dd4cfb3f1", "tree_id": "00a8961df70e2a8783395ab2e2003c959423149c", "message": "fix: type-confusion in JSON object deserializer (JSON.parse) (#460)\n\nGHSA-c3f8-98q2-cqvr\n\ngravity_class_deserialize() and gravity_function_deserialize() trusted the JSON\nvalue type of nested fields and read the wrong union member without validating\nit. Because json_value's string, array and object variants alias the same\n{length, ptr} layout, a JSON string supplied where an array/object/integer was\nexpected is reinterpreted as an attacker-controlled pointer+length pair. Every\nbranch is reachable from the default-registered JSON.parse() on untrusted input:\n\n- inames: a string aliased as an array dereferenced each 8 bytes as a\n  json_value* -> read from a fully attacker-chosen address (arbitrary read).\n- $get/$set: gravity_function_deserialize() read json->u.object.length off a\n  non-object value -> heap OOB read walking string bytes as object entries.\n- super/nivar/sivar: entered on \"type != json_object\" with no further check ->\n  NULL deref (strcmp on the zeroed offset-8 word) or an aliased heap pointer\n  copied as a C string (info leak). The identifier used assert(), compiled out\n  under NDEBUG, leaving the release build unguarded.\n\nValidate value->type against the union member actually read before touching it:\nrequire json_string for super and the class identifier, json_integer for\nnivar/sivar, json_array for inames/meta, and reject a non-object at the top of\ngravity_function_deserialize(). Mismatches now abort the load (return NULL)\ninstead of reading out of bounds or dereferencing a forged pointer. The\nidentifier assert() is replaced by a real check so release builds are covered.\n\nAdd a regression test exercising each malformed field plus a well-formed map.\n\nCo-authored-by: Claude Opus 4.8 <noreply@anthropic.com>", "timestamp": "2026-09-19T07:33:10Z", "author": {"name": "Marco Bambini", "email": "marco@creolabs.com"}, "committer": {"name": "GitHub", "email": "noreply@github.com"}}, "repository": {"id": 83052165, "node_id": "MDEwOlJlcG9zaXRvcnk4MzA1MjE2NQ==", "name": "gravity", "full_name": "marcobambini/gravity", "private": false, "owner": {"login": "marcobambini", "id": 11838145, "node_id": "MDQ6VXNlcj