ed_url": "https://api.github.com/users/github-merge-queue%5Bbot%5D/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/github-merge-queue%5Bbot%5D/subscriptions", "organizations_url": "https://api.github.com/users/github-merge-queue%5Bbot%5D/orgs", "repos_url": "https://api.github.com/users/github-merge-queue%5Bbot%5D/repos", "events_url": "https://api.github.com/users/github-merge-queue%5Bbot%5D/events{/privacy}", "received_events_url": "https://api.github.com/users/github-merge-queue%5Bbot%5D/received_events", "type": "Bot", "user_view_type": "public", "site_admin": false}, "jobs_url": "https://api.github.com/repos/bevyengine/bevy/actions/runs/36389814261/jobs", "logs_url": "https://api.github.com/repos/bevyengine/bevy/actions/runs/36389814261/logs", "check_suite_url": "https://api.github.com/repos/bevyengine/bevy/check-suites/98529121388", "artifacts_url": "https://api.github.com/repos/bevyengine/bevy/actions/runs/36389814261/artifacts", "cancel_url": "https://api.github.com/repos/bevyengine/bevy/actions/runs/36389814261/cancel", "rerun_url": "https://api.github.com/repos/bevyengine/bevy/actions/runs/36389814261/rerun", "previous_attempt_url": null, "workflow_url": "https://api.github.com/repos/bevyengine/bevy/actions/workflows/8778130", "head_commit": {"id": "20e1e1b7b4c6f2ae406b1e6669b86be0b02131f9", "tree_id": "2baa97192026fe2d725555f685763080982f240d", "message": "Add bevy_inspector crate with a local entity tree (#25884)\n\n# Objective\n\nPart of #23013.\n\nStart the inspector GUI the working group design doc calls for, a new\ncrate built on bevy_ui and feathers. This first piece is the crate and a\nlocal entity tree.\n\n# Solution\n\nA `bevy_inspector` crate wired into the engine like feathers, behind a\nfeature.\n\n- an entity tree panel using the feathers tree view, showing root\nentities with labels from label resolution, children populated on first\nexpand\n- the tree mirrors the world every quarter second, adding and removing\nrows and relabelling on name changes, and hides the inspector's own\nentities, resources, systems and observers\n- selecting a row records the source entity in a resource for the panels\nthat follow\n- a `local_inspector` example with a small scene\n\nDetails, editing and the remote source come in the next PRs on this\nstack.\n\n# AI disclosure\n\nPart of the inspector series. The plan and the split into small PRs came\nfrom discussing scope up front, and AI did the mechanical side of each\npiece, moving code out of Jackdaw into the right files on a fresh branch\nand checking it for errors while I reviewed. Building this crate is\nwhere I noticed that feathers' text font propagation stops at any\nintermediate node without `ThemedText`, which left the tree labels in\nthe default font until the tree view in #25862 was fixed. It also showed\nthe entity tree has to explicitly hide the inspector's own UI,\nresources, systems and observers, or it fills up with them.\n\n# Showcase\n<img width=\"944\" height=\"1020\" alt=\"image\"\nsrc=\"https://github.com/user-attachments/assets/7bf14391-9a78-4e67-82e3-f4e40e1fcbbd\"\n/>", "timestamp": "2026-09-28T05:58:49Z", "author": {"name": "Joe Buehler", "email": "jbuehler23@gmail.com"}, "committer": {"name": "GitHub", "email": "noreply@github.com"}}, "repository": {"id": 234798675, "node_id": "MDEwOlJlcG9zaXRvcnkyMzQ3OTg2NzU=", "name": "bevy", "full_name": "bevyengine/bevy", "private": false, "owner": {"login": "bevyengine", "id": 60047606, "node_id": "MDEyOk9yZ2FuaXphdGlvbjYwMDQ3NjA2", "avatar_url": "https://avatars.githubusercontent.com/u/60047606?v=4", "gravatar_id": "", "url": "https://api.github.com/users/bevyengine", "html_url": "https://github.com/bevyengine", "followers_url": "https://api.github.com/users/bevyengine/followers", "following_url": "https://api.github.com/users/bevyengine/following{/other_user}", "gists_url": "https://api.github.com/users/bevyengine/gists{/gist_id}", "starred_url": "https://api.github.com/users/be